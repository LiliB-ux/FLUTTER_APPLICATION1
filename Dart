                                      hintText: 'Search city...',
                                      hintStyle: TextStyle(
                                        color: Colors.white70,
                                      ),
                                      border: InputBorder.none,
                                    ),
                                  ),
                                ),
                                IconButton(
                                  onPressed:
                                      isLoading ? null : fetchWeatherByLocation,
