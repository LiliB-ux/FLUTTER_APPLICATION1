  Future<void> fetchWeather(String city) async {
    if (city.trim().isEmpty) return;

    setState(() {
      isLoading = true;
      errorMessage = '';
    });

    try {
      final currentUrl = Uri.parse(
        'https://api.openweathermap.org/data/2.5/weather?q=$city&appid=$apiKey&units=metric',
      );

      final forecastUrl = Uri.parse(
        'https://api.openweathermap.org/data/2.5/forecast?q=$city&appid=$apiKey&units=metric',
      );

      final responses = await Future.wait([
        http.get(currentUrl),
        http.get(forecastUrl),
      ]);

      final currentResponse = responses[0];
      final forecastResponse = responses[1];

      if (currentResponse.statusCode != 200) {
        setState(() {
          errorMessage = 'Current weather failed: ${currentResponse.body}';
          isLoading = false;
        });
        return;
      }

      if (forecastResponse.statusCode != 200) {
        setState(() {
          errorMessage = 'Forecast failed: ${forecastResponse.body}';
          isLoading = false;
        });
        return;
      }

      final currentData = jsonDecode(currentResponse.body);
      final forecastData = jsonDecode(forecastResponse.body);

      final List forecastItems = forecastData['list'];

      setState(() {
        cityName = currentData['name'] ?? '';
        country = currentData['sys']?['country'] ?? '';
        description = currentData['weather'][0]['description'] ?? '';
        iconCode = currentData['weather'][0]['icon'] ?? '01d';

        temp = (currentData['main']['temp'] ?? 0).toDouble();
        feelsLike = (currentData['main']['feels_like'] ?? 0).toDouble();
        tempMin = (currentData['main']['temp_min'] ?? 0).toDouble();
        tempMax = (currentData['main']['temp_max'] ?? 0).toDouble();
        humidity = currentData['main']['humidity'] ?? 0;
        windSpeed = (currentData['wind']['speed'] ?? 0).toDouble();
        pressure = currentData['main']['pressure'] ?? 0;
        visibility = currentData['visibility'] ?? 0;

        forecastList =
            forecastItems.take(8).map((item) {
              return ForecastItem(
                time: item['dt_txt'] ?? '',
                temp: (item['main']['temp'] ?? 0).toDouble(),
                iconCode: item['weather'][0]['icon'] ?? '01d',
                description: item['weather'][0]['description'] ?? '',
              );
            }).toList();

        isLoading = false;
      });
    } catch (e) {
      setState(() {
        errorMessage = 'Something went wrong: $e';
        isLoading = false;
      });
    }
  }

  List<Color> getGradientColors() {
    final text = description.toLowerCase();
    final isNight = iconCode.endsWith('n');

    if (text.contains('snow')) {
      return isNight
          ? const [Color(0xFF0F172A), Color(0xFF1E293B), Color(0xFF334155)]
          : const [Color(0xFF60A5FA), Color(0xFFA5B4FC), Color(0xFFE0F2FE)];
    }

    if (text.contains('rain') || text.contains('drizzle')) {
      return isNight
          ? const [Color(0xFF020617), Color(0xFF0F172A), Color(0xFF1D4ED8)]
          : const [Color(0xFF0F172A), Color(0xFF1D4ED8), Color(0xFF38BDF8)];
    }

    if (text.contains('cloud')) {
      return isNight
          ? const [Color(0xFF111827), Color(0xFF1F2937), Color(0xFF374151)]
          : const [Color(0xFF334155), Color(0xFF475569), Color(0xFF64748B)];
    }

    if (text.contains('thunder')) {
      return const [Color(0xFF020617), Color(0xFF111827), Color(0xFF312E81)];
    }

    if (text.contains('clear')) {
      return isNight
          ? const [Color(0xFF020617), Color(0xFF0F172A), Color(0xFF1E1B4B)]
          : const [Color(0xFF7C3AED), Color(0xFFEC4899), Color(0xFFF59E0B)];
    }

    return isNight
        ? const [Color(0xFF020617), Color(0xFF0F172A), Color(0xFF1E293B)]
        : const [Color(0xFF2563EB), Color(0xFF7C3AED), Color(0xFFEC4899)];
  }

  String capitalizeWords(String text) {
    return text
        .split(' ')
        .map((word) {
          if (word.isEmpty) return word;
          return word[0].toUpperCase() + word.substring(1);
        })
        .join(' ');
  }

  String formatTime(String raw) {
    try {
      final dt = DateTime.parse(raw);
      final hour = dt.hour;
      final minute = dt.minute.toString().padLeft(2, '0');
      final suffix = hour >= 12 ? 'PM' : 'AM';
      final twelveHour = hour % 12 == 0 ? 12 : hour % 12;
      return '$twelveHour:$minute $suffix';
    } catch (_) {
      return raw;
    }
  }

