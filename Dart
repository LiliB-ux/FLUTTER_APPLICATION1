                                    ),
                                  ),
                                ],
                              ),
                            )
                          else ...[
                            Transform.translate(
                              offset: Offset(0, floatY),
                              child: GestureDetector(
                                onTap: showWeatherDetailsSheet,
                                child: glassCard(
                                  child: Column(
                                    children: [
                                      Text(
                                        capitalizeWords(description),
