                                      const SizedBox(height: 4),
                                      ShaderMask(
                                        shaderCallback: (bounds) {
                                          return const LinearGradient(
                                            colors: [
                                              Colors.white,
                                              Color(0xFFFFE4F1),
                                              Color(0xFFE0EAFF),
                                            ],
                                          ).createShader(bounds);
                                        },
                                        child: Text(
                                          '${temp.toStringAsFixed(1)}°',
                                          style: const TextStyle(
                                            color: Colors.white,
