  String getLottieAsset() {
    final text = description.toLowerCase();
    final isNight = iconCode.endsWith('n');

    if (text.contains('snow')) return 'assets/lottie/snow.json';

    if (text.contains('rain') || text.contains('drizzle')) {
      return 'assets/lottie/rain.json';
    }

    if (text.contains('thunder')) return 'assets/lottie/storm.json';

    if (text.contains('wind')) return 'assets/lottie/wind.json';

    if (text.contains('cloud')) return 'assets/lottie/cloud.json';

    if (text.contains('clear')) {
      return isNight ? 'assets/lottie/moon.json' : 'assets/lottie/sun.json';
    }

    return isNight ? 'assets/lottie/moon.json' : 'assets/lottie/sun.json';
  }

  Future<void> _loadFavorites() async {
    final prefs = await SharedPreferences.getInstance();

    setState(() {
